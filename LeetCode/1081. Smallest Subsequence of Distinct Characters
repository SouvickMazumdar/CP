class Solution:
    def smallestSubsequence(self, s: str) -> str:
        L=Counter(s)
        v=[0]*26
        stk=[]
        for ch in s:

            while stk and stk[-1]>ch:
                if L[stk[-1]]>0 and v[ord(ch)-ord('a')]==0:
                    # print(stk)
                    v[ord(stk[-1])-ord('a')]=0
                    stk.pop()
                else:
                    break
            # print("HELLO")
            if v[ord(ch)-ord('a')]==0: 
                stk.append(ch)
                v[ord(ch)-ord('a')]=1
            L[ch]-=1
        return "".join(stk)
