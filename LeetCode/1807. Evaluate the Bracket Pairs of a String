class Solution:
    def evaluate(self, s: str, knowledge: list[list[str]]) -> str:
        n=len(s)
        i=0;j=0;flag=0
        dt={}
        for key, value in knowledge:
            dt[key]=value
        ans=[]
        key=""
        while j<n:
            if flag==1 and s[j]!=')':
                  key+=s[j]
            if s[j]=='(':
                flag=1
            elif s[j]==')' and flag==1:
                flag=0
                # print("Key:", key)
                if key in dt.keys():
                    ans.append(dt[key])
                else:
                    ans.append('?')
                key=""
            else:
                if flag==0:
                    ans.append(s[j])
            j+=1
        return ''.join(ans)
